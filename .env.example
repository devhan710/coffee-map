# NCP Maps JS — 콘솔의 Client ID를 ncpKeyId로 사용합니다.
# 브라우저에 노출됩니다. NCP Web 서비스 URL은 포트 없이 http://localhost 만 등록하세요.
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# NCP Maps Client Secret. 지도 JS에는 쓰지 않습니다.
# Geocoding(주소→좌표)을 쓰려면 같은 앱에서 Geocoding API를 켜세요.
NAVER_MAP_CLIENT_SECRET=

# Naver Search API (server only). 지역검색으로 좌표·장소를 찾을 때 씁니다.
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# Firebase (browser). Console Web 앱 설정값입니다.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
