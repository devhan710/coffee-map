rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: Firebase Auth uid
    // Fields:
    //   - preferredDrinkIds: list<string> (required, 0-5 items,
    //       each one of americano|drip|latte|einspanner|other)
    //   - updatedAt: timestamp (required, must be recent)
    // Notes:
    //   - Owner-only read/write. Contains private taste data.
    //   - No email/name/PII fields are stored here.
    //
    // Collection: users/{userId}/favorites
    // Document ID: cafeId (slug, 2-80 chars, [a-z0-9-])
    // Fields:
    //   - cafeId: string (required, must equal document ID)
    //   - createdAt: timestamp (required, immutable, must be recent)
    // Notes:
    //   - Owner-only read/write. Updates are forbidden; delete to unfavorite.
    //
    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isRecent(time) {
      return time is timestamp &&
        time > request.time - duration.value(5, 'm') &&
        time <= request.time;
    }

    function allowedDrinkIds() {
      return ['americano', 'drip', 'latte', 'einspanner', 'other'];
    }

    function isValidCafeId(cafeId) {
      return cafeId is string && cafeId.matches('^[a-z0-9-]{2,80}$');
    }

    function isValidUser(data) {
      return hasRequiredFields(['preferredDrinkIds', 'updatedAt']) &&
        hasOnlyAllowedFields(['preferredDrinkIds', 'updatedAt']) &&
        data.preferredDrinkIds is list &&
        data.preferredDrinkIds.size() <= 5 &&
        data.preferredDrinkIds.hasOnly(allowedDrinkIds()) &&
        isRecent(data.updatedAt);
    }

    function isValidFavorite(data, cafeId) {
      return hasRequiredFields(['cafeId', 'createdAt']) &&
        hasOnlyAllowedFields(['cafeId', 'createdAt']) &&
        data.cafeId is string &&
        data.cafeId == cafeId &&
        isValidCafeId(data.cafeId) &&
        isRecent(data.createdAt);
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) &&
        isValidUser(request.resource.data) &&
        uidUnchanged() &&
        uidNotModified();
      allow delete: if isOwner(userId);

      match /favorites/{cafeId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidFavorite(request.resource.data, cafeId);
        allow update: if false;
        allow delete: if isOwner(userId);
      }
    }
  }
}
